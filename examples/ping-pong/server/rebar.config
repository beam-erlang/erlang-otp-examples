{erl_opts, [debug_info, warnings_as_errors]}.
{deps, [{cowboy, "2.20.0"}]}.
{shell, [{apps, [ping_pong_server]}]}.
{relx, [{release, {ping_pong_server, "0.1.0"}, [ping_pong_server]},
        {dev_mode, true}, {include_erts, false},
        {sys_config, "config/sys.config"}, {vm_args, "config/vm.args"}]}.
{profiles, [{prod, [{relx, [{dev_mode, false}, {include_erts, true}]}]}]}.
